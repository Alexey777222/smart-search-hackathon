# Ключ сервисного аккаунта Yandex Cloud (scope: yc.ai.foundationModels.execute).
# Ключ хранится только на сервере и никогда не попадает в браузер.
YANDEX_API_KEY=

# Идентификатор каталога (folder) Yandex Cloud.
YANDEX_FOLDER_ID=

# OpenAI-совместимый endpoint Яндекса.
YANDEXGPT_BASE_URL=https://llm.api.cloud.yandex.net/v1

# Модель. По умолчанию подставляется gpt://<YANDEX_FOLDER_ID>/yandexgpt/latest.
# Для YandexGPT Pro 5.1 укажите URI из консоли AI Studio.
YANDEXGPT_MODEL=

# Ограничения платных запросов и тайм-аут (секунды).
AI_MAX_CALLS_PER_SESSION=8
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=800

# Порт веб-стенда.
PORT=8000
